
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum BillingStatus {
  pending
  paid
  failed
  refunded
}
model CurrencyRate {
  code      String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rate      Float
}
model Billing {
  idBilling Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  idUser    String
  price     Float
  paymentMethod String?
  paymentReference String?
  status   String
  idTeacher String
  teacher   User    @relation(fields: [idTeacher], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
model Booking {
  idBooking Int      @id @default(autoincrement())
  idUser    String
  idLesson  Int
  user      User    @relation("BookingUser", fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lesson    Lesson @relation(fields: [idLesson], references: [idLesson], onDelete: Cascade, onUpdate: Cascade)
  @@unique([idUser, idLesson])
}

model Lesson {
  idLesson    Int          @id @default(autoincrement())
  title       String
  description String?
  url         String?
  startDate   DateTime     @db.Timestamp(0)
  duration    Int          @default(50)
  status      LessonStatus @default(planned)
  groupSize   Int          @default(2)
  createdAt   DateTime
  idTeacher   String
  teacher     User         @relation(fields: [idTeacher], references: [id], onUpdate: Cascade)
  bookings    Booking[]
}

model Pricings {
  idPricing Int    @id @default(autoincrement())
  currency  String
  price     Float?
  nbLessons Int
}

enum LessonStatus {
  planned
  done
  cancelled
}

enum UserRole {
  student
  teacher
  admin
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  languages     String[]
  nationality   String[]
  description   String?
  role          UserRole   @default(student)
  nbLessons     Int?       @default(0)
  bookings      Booking[] @relation("BookingUser")
  lessons       Lesson[]
  @@map("user")
  Billing Billing[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
